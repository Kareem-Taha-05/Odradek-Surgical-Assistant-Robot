<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="odradek_surgical_assistant">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import odradek_surgical_assistant urdf file -->
    <xacro:include filename="$(find surgical_assistant_description)/urdf/med_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="odradek_surgical_assistant.ros2_control.xacro" />


    <xacro:odradek_surgical_assistant_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
